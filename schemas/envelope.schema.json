{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sirwilliamiv/embodied-agent-protocol/schemas/0.1/envelope.schema.json",
  "title": "EAP message envelope",
  "type": "object",
  "required": [
    "v",
    "id",
    "ts",
    "from",
    "type",
    "payload"
  ],
  "properties": {
    "v": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "ts": {
      "type": "integer",
      "description": "Unix ms"
    },
    "from": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "director",
            "stage",
            "manager"
          ]
        },
        "stageId": {
          "type": "string"
        }
      }
    },
    "type": {
      "enum": [
        "stage.hello",
        "stage.transform",
        "stage.bye",
        "actor.state",
        "verb.summon",
        "verb.cross",
        "verb.point",
        "verb.traverse",
        "verb.speak",
        "verb.retire",
        "target.resolve",
        "target.resolved",
        "target.lost",
        "target.outcome",
        "consent.requested",
        "consent.granted",
        "consent.denied",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
